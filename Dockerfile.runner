FROM node:24-bookworm-slim
WORKDIR /app
RUN npm install --prefix /app --omit=dev --no-audit --no-fund ssh2@1.17.0 ws@8.21.0
COPY runner/ ./runner/
COPY lib/environment.mjs lib/env-requirements.mjs lib/project-name.mjs lib/job-actions.mjs lib/agent-path.mjs ./lib/
RUN mkdir /data && chown node:node /data
USER node
ENV HOST=0.0.0.0 PORT=8788 EZDEPLOY_DATA_DIR=/data
EXPOSE 8788
CMD ["node", "runner/server.mjs"]
